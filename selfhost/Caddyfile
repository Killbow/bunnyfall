# BUNNYFALL: the public front door. Caddy fetches and renews the HTTPS certificate on its own.
# Behind another web server (nginx on a panel box, selfhost/nginx-bunnyfall.conf), DOMAIN=":80" makes it plain HTTP.
{
	servers {
		# the player's own address, as a proxy in front of us says it (nginx), for the services' per-address limits
		# BUNNYFALL AUDIT L1-01: strict - the address is the right-most one a trusted proxy did not write, so a header the
		# caller sent ahead of nginx's own entry is never taken. TRUSTED_PROXIES (in .env) is who may speak for a player:
		# `private_ranges` behind nginx on this box (the default), but on a box that faces the internet itself set it to
		# 127.0.0.1/32 - Docker's userland proxy (IPv6, rootless) otherwise shows callers as a private address that is trusted.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
	}
}

(player) {
	header_up CF-Connecting-IP {client_ip}
}

{$DOMAIN:dagg.campfirerp.com} {
	encode zstd gzip

	# the account service's local cron door, never public
	@sched path /accounts/__scheduled*
	respond @sched 404

	handle_path /relay/* {
		reverse_proxy server:8787 {
			import player
		}
	}
	handle_path /updater/* {
		reverse_proxy server:8789 {
			import player
		}
	}
	handle /v1/* {
		reverse_proxy server:8788 {
			import player
		}
	}
	handle_path /accounts/* {
		reverse_proxy server:8788 {
			import player
		}
	}
	handle {
		root * /srv
		file_server
	}
}
