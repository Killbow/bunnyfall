[
  {
    "name": "REL4-1-publish-stops-waiting-for-the-matrix",
    "file": "selfhost/upstream-ci/workflows/release-desktop.yml",
    "old": "    needs: [version, build]\n",
    "new": "    needs: [version]\n",
    "tests": [
      "test/tooling/rel4_release.test.js"
    ],
    "note": "The release would be cut beside legs still building - the partial `latest` REL4 exists to end."
  },
  {
    "name": "REL4-2-publish-runs-when-a-leg-failed",
    "file": "selfhost/upstream-ci/workflows/release-desktop.yml",
    "old": "    needs: [version, build]\n    if: needs.version.outputs.tag != ''\n",
    "new": "    needs: [version, build]\n    if: always() && needs.version.outputs.tag != ''\n",
    "tests": [
      "test/tooling/rel4_release.test.js"
    ],
    "note": "always() drops the implicit success(): a dead Windows leg would publish a release with no Windows installer."
  },
  {
    "name": "REL4-3-the-release-is-live-while-its-files-upload",
    "file": "selfhost/upstream-ci/workflows/release-desktop.yml",
    "old": "          draft: true\n",
    "new": "          draft: false\n",
    "tests": [
      "test/tooling/rel4_release.test.js"
    ]
  },
  {
    "name": "REL4-4-the-set-is-never-checked",
    "file": "selfhost/upstream-ci/workflows/release-desktop.yml",
    "old": "        run: node scripts/desktopRelease.mjs check release\n",
    "new": "        run: ls release\n",
    "tests": [
      "test/tooling/rel4_release.test.js",
      "test/tooling/autoupdate.test.js"
    ]
  },
  {
    "name": "REL4-5-a-leg-publishes-again",
    "file": "selfhost/upstream-ci/workflows/release-desktop.yml",
    "old": "      - name: Hand the installers on\n        uses: actions/upload-artifact@v4\n",
    "new": "      - name: Hand the installers on\n        uses: softprops/action-gh-release@v2\n",
    "tests": [
      "test/tooling/rel4_release.test.js"
    ]
  },
  {
    "name": "REL4-6-the-draft-is-published-without-deciding-latest",
    "file": "selfhost/upstream-ci/workflows/release-desktop.yml",
    "old": " -F draft=false -f make_latest=\"$MAKE_LATEST\" --silent\n",
    "new": " -F draft=false --silent\n",
    "tests": [
      "test/tooling/rel4_release.test.js"
    ],
    "note": "GitHub makes a newly published release latest by default - a hand re-cut of an old build would move every download link and updater back to it."
  },
  {
    "name": "REL4-7-the-notes-keep-only-the-first-file",
    "file": "scripts/desktopRelease.mjs",
    "old": "  return `${parts.length ? parts.join('\\n\\n') : NO_NOTES_TEXT}\\n`;\n",
    "new": "  return `${parts.length ? parts.slice(0, 1).join('\\n\\n') : NO_NOTES_TEXT}\\n`;\n",
    "tests": [
      "test/tooling/rel4_release.test.js"
    ]
  },
  {
    "name": "REL4-8-an-old-build-takes-latest",
    "file": "scripts/desktopRelease.mjs",
    "old": "    if (mine[i] !== cur[i]) return mine[i] > cur[i];\n",
    "new": "    if (mine[i] !== cur[i]) return true;\n",
    "tests": [
      "test/tooling/rel4_release.test.js"
    ]
  },
  {
    "name": "REL4-9-the-tag-being-cut-is-its-own-previous",
    "file": "scripts/desktopRelease.mjs",
    "old": "'--match', 'app-v*', '--exclude', tag, at",
    "new": "'--match', 'app-v*', at",
    "tests": [
      "test/tooling/rel4_release.test.js"
    ],
    "note": "On the tag door the tag already names HEAD, so the diff would be empty and the notes would say nothing came with the release."
  },
  {
    "name": "REL4-10-the-check-passes-anything",
    "file": "scripts/desktopRelease.mjs",
    "old": "  return EXPECTED_RELEASE_FILES.filter((f) => !have.has(f));\n",
    "new": "  return [];\n",
    "tests": [
      "test/tooling/rel4_release.test.js"
    ]
  }
]
